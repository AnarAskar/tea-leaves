# Supabase category images (run once in SQL Editor if admin shows PGRST204):
# supabase/setup_category_images.sql
# Then: wait ~10s, sign out/in at /admin, test category save + upload.

# Required on Vercel (Settings → Environment Variables) before deploy
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_NUM_TABLES=25
# Optional: production site URL (QR codes, keepalive)
VITE_BASE_URL=

# Required on Vercel for orders / bill / notes / feedback (server only — no VITE_ prefix)
BOT_TOKEN=
CHAT_ID=

# Admin auto-translate (server only — no VITE_ prefix). Google Gemini API key
# (free tier, from https://aistudio.google.com/apikey) powers the "translate"
# buttons on menu item / category fields. Optional model override.
GEMINI_API_KEY=
# TRANSLATE_MODEL=gemini-2.0-flash

# One-time menu seed (scripts/seed-mynu-once.mjs — not needed in production)
# One-time image migration (scripts/migrate-mynu-images.mjs — run 006_menu_images_bucket.sql first)
# Use the SECRET key from Supabase → Project Settings → API (NOT the publishable sb_publishable_ key):
# SUPABASE_SERVICE_ROLE_KEY=
# Or sign in as admin instead:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# GitHub Actions keepalive (.github/workflows/keepalive.yml)
# SITE_URL=https://your-menu.example.com
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
